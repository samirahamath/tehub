{
  "appId": "in.tehub.app",
  "appName": "TEHUB",
  "webDir": "www",
  "server": {
    "url": "https://tehub.in",
    "cleartext": false,
    "errorPath": "error.html"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "launchAutoHide": true,
      "launchFadeOutDuration": 500,
      "backgroundColor": "#0A0A0C",
      "androidSplashResourceName": "splash",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#0A0A0C"
    },
    "Keyboard": {
      "resize": "body",
      "style": "DARK"
    }
  },
  "android": {
    "allowMixedContent": false,
    "captureInput": true,
    "webContentsDebuggingEnabled": false
  }
}
